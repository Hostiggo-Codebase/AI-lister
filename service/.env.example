# ---- Database (Supabase Postgres — use the connection pooler string) ----
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-xx.pooler.supabase.com:6543/postgres
DB_SCHEMA=hostiggo_testing_schema
IMPORT_SCHEMA=hostiggo_testing_schema

# ---- Supabase Storage (for re-hosting photos) ----
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PHOTO_BUCKET=homestay-photos

# ---- LLM extraction ----
ANTHROPIC_API_KEY=
IMPORT_LLM_MODEL=claude-sonnet-5

# ---- FX ----
FX_API_URL=                       # optional; leave blank to use the static table
FX_BASE_CURRENCY=INR

# ---- Pipeline tuning ----
IMPORT_MAX_PHOTOS=40
IMPORT_TIER2_ENABLED=true
IMPORT_FETCH_TIMEOUT_S=20
IMPORT_PHOTO_MAX_BYTES=8000000
IMPORT_WORKER_CONCURRENCY=2

# ---- Service ----
API_KEY=                          # optional bearer token to protect the API
LOG_LEVEL=INFO
