# Copy to .env and fill in. Keep comments on their OWN lines — never after a value.

# --- Database: Supabase Postgres. Use the "Transaction pooler" connection string.
DATABASE_URL=
DB_SCHEMA=hostiggo_testing_schema
IMPORT_SCHEMA=hostiggo_testing_schema

# --- Supabase Storage (re-hosting photos). Needs the service_role key, not anon.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PHOTO_BUCKET=homestay-photos

# --- LLM extraction (Anthropic). Leave ANTHROPIC_API_KEY blank to use the heuristic.
ANTHROPIC_API_KEY=
IMPORT_LLM_MODEL=claude-sonnet-5

# --- FX. Leave FX_API_URL blank to use the built-in static rate table.
FX_API_URL=
FX_BASE_CURRENCY=INR

# --- Pipeline tuning
IMPORT_MAX_PHOTOS=40
IMPORT_TIER2_ENABLED=true
IMPORT_FETCH_TIMEOUT_S=20
IMPORT_PHOTO_MAX_BYTES=8000000
IMPORT_WORKER_CONCURRENCY=2

# --- Service. Set API_KEY to require: Authorization: Bearer <key> on every /v1 route.
API_KEY=
LOG_LEVEL=INFO
